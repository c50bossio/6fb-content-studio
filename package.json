{
  "name": "6fb-content-studio",
  "version": "1.5.39",
  "description": "6FB Content Studio — Professional content creation tools for barbers",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run package:mac",
    "package:mac": "node scripts/assert-packaged-runtime.cjs darwin-arm64 && electron-vite build && electron-builder --mac",
    "package:mac:release": "node scripts/assert-packaged-runtime.cjs darwin-arm64 && electron-vite build && electron-builder --mac --config.forceCodeSigning=true",
    "package:win": "node scripts/assert-packaged-runtime.cjs win32-x64 && electron-vite build && electron-builder --win --x64",
    "runtime:mac": "bash scripts/build-pipeline-runtime.sh",
    "runtime:win": "powershell -ExecutionPolicy Bypass -File scripts/build-pipeline-runtime.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "execa": "^9.5.0",
    "html-to-image": "^1.11.13",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "com.6fbmentorship.contentstudio",
    "productName": "6FB Content Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "python/tools",
        "to": "python/tools"
      },
      {
        "from": "python/runtime",
        "to": "python/runtime"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "6FB-Content-Studio-${arch}.${ext}",
      "notarize": true
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "iconSize": 120
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "6FB-Content-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "6FB-Content-Studio-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "c50bossio",
      "repo": "6fb-content-studio"
    }
  }
}
